  "scripts": {
    "start": "react-scripts start",
    "build": "CI=false react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "cards": "node scripts/cards.mjs all",
    "cards:build": "node scripts/cards.mjs build",
