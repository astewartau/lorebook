{
  "name": "lorebook",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.54.0",
    "@tanstack/react-query": "^5.107.1",
    "lucide-react": "^0.536.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.8.0",
    "remark-gfm": "^4.0.1"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "cards": "node scripts/cards.mjs all",
    "cards:build": "node scripts/cards.mjs build",
    "db": "scripts/supabase.sh",
    "db:start": "scripts/supabase.sh start",
    "db:stop": "scripts/supabase.sh stop",
    "db:reset": "scripts/supabase.sh db reset && node scripts/cards.mjs sync",
    "db:test": "scripts/supabase.sh test db",
    "db:types": "scripts/supabase.sh gen types typescript --local > src/lib/database.types.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "seed:demo": "node scripts/seed-demo.mjs",
    "db:env": "node scripts/local-env.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "supabase": "^3.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
